      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.5, sum by (le, acks) (rate(bunnymq_raft_propose_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50 acks={{acks}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.99, sum by (le, acks) (rate(bunnymq_raft_propose_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p99 acks={{acks}}",
          "refId": "B"
        }
      ],
      "title": "Propose Latency p50/p99 (by acks)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "custom": {"lineWidth": 1, "fillOpacity": 10}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 31},
