          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.99, sum by (le, shard_id) (rate(bunnymq_raft_fsm_update_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "shard {{shard_id}}",
          "refId": "A"
        }
