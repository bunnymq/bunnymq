          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "bunnymq_raft_committed_index{instance=~\"$instance\"} - bunnymq_raft_applied_index{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} shard {{shard_id}}",
          "refId": "A"
        }
      ],
      "title": "Committed − Applied Index Lag",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
